---
/**
 * Boot.astro — the killchain boot film.
 *
 * Six shots, hard cut, on a character grid. The markup is the finished frame;
 * boot.ts cuts between shots and gates the reveal animations. Everything on
 * screen comes from the shipped code: the CLI as documented in README "Run",
 * the dimensions, thresholds and kind slack in routing.py, the gate in gate.py,
 * the paths in paths.py, and the contract shape in contract.py.
 */
import '../styles/boot.css';
import { DIMENSIONS, SHOTS, bar } from '../lib/boot';

/** The banner is five fixed-width rows. 46 cells, never re-wrapped. */
const BANNER = [
  '█   █ ███ █    █     ███ █   █  ███  ███ █   █',
  '█  █   █  █    █    █    █   █ █   █  █  ██  █',
  '███    █  █    █    █    █████ █████  █  █ █ █',
  '█  █   █  █    █    █    █   █ █   █  █  █  ██',
  '█   █ ███ ████ ████  ███ █   █ █   █ ███ █   █',
];

/** shot 1: the command line, as shipped. */
const CMD = 'killchain "build X using our proprietary Y" --frontier codex';

const BOOT_LINES: { text: string; color: string; at: number; type?: boolean }[] = [
  { text: '~ ', color: 'dim', at: 0.2 },
  { text: CMD, color: 'white', at: 0.35, type: true },
];

/** shot 2: the eight shipped dimensions and their bars, from routing.py. */
const MAP_ROWS = DIMENSIONS.map((d, i) => {
  const b = bar(d.bar, 4);
  const pulled = ['reverse_engineering', 'proprietary_model', 'attribution'].includes(d.id);
  return {
    ...d,
    glyph: b.text,
    barText: d.bar.toFixed(2),
    route: pulled ? 'PRIVATE' : 'PUBLIC',
    pulled,
    at: 0.55 + i * 0.34,
  };
});

const PUBLIC_TREE = [
  'public/',
  '  contracts/',
  '    extract.py',
  '    score.py',
  '  tests/',
  '    test_contracts.py',
  '  NOTES.md',
];

const PRIVATE_TREE = [
  '~/killchain-private/<run>/',
  '  prompt.md',
  '  contract.json',
  '  private_impl/',
  '    extract.py',
  '    score.py',
  '  private_fixtures.json',
];

const ariaSummary =
  'A terminal recording. killchain takes one build prompt and partitions it by refusal risk. ' +
  'Each span is scored across eight dimensions; spans over their bar are pulled out of the ' +
  'public view. A frontier agent builds public/ against contract stubs while an abliterated ' +
  'orchestrator implements private_impl/. Contract tests in real mode prove the halves fit.';

const last = SHOTS[SHOTS.length - 1];
---

<section class="boot" data-shot="end" aria-label="killchain, in one terminal">
  <p class="visually-hidden">{ariaSummary}</p>

  <div class="boot__film">
    <!-- tabline: the six shots are tabs, the active one is inverted -->
    <div class="boot__tabs" aria-hidden="true">
      {
        SHOTS.map((s) => (
          <span class="boot__tab" data-for={s.id}>
            {s.label}
          </span>
        ))
      }
      <span class="boot__tabs-right">
        <span class="boot__rec"></span>
        <span>killchain · v0.1.0</span>
      </span>
    </div>

    <div class="boot__frame">
      <!-- ============================================== 1 · run -->
      <div class="shot shot--boot">
        {
          BOOT_LINES.map((l) => (
            <div class="line">
              {l.type ? (
                <span class="run type" data-c={l.color} style={`--d:${l.at}s;--n:${l.text.length}`}>
                  {l.text}
                </span>
              ) : (
                <span class="run on" data-c={l.color} style={`--d:${l.at}s`}>
                  {l.text}
                </span>
              )}
            </div>
          ))
        }
        <div class="line"></div>

        <div class="banner on" style="--d:2.2s">
          {BANNER.map((row) => <div class="line">{row}</div>)}
        </div>

        <div class="line on" data-c="cyan" style="--d:2.7s">
          {'refusal-first split build'}
        </div>
        <div class="line"></div>
        <div class="line on" data-c="dim" style="--d:2.95s">
          {'one prompt in. two halves out. the frontier never sees the risky half.'}
        </div>
        <div class="line"></div>
        <div class="line on only-wide" data-c="orange" style="--d:3.2s">
          {'" doctor: config · claude/codex binary · both keys · private dir mode · denylist · round-trip'}
        </div>
        <div class="line on only-wide" data-c="dim" style="--d:3.45s">
          {'  exits non-zero only if something fatal to a run is wrong.'}
        </div>
        <div class="line on only-narrow" data-c="orange" style="--d:3.2s">
          {'" doctor: keys, denylist, round-trip'}
        </div>
      </div>

      <!-- ============================================== 2 · risk map -->
      <div class="shot shot--map">
        <div class="line on" data-c="yellow" style="--d:0.05s">
          {' span 03  "reimplement the scoring endpoint behind their SDK"'}
        </div>
        <div class="line on only-wide" data-c="orange" style="--d:0.18s">
          {' "bar = routing.THRESHOLDS. a span over its bar is pulled out of the public view."'}
        </div>
        <div class="line on only-narrow" data-c="orange" style="--d:0.18s">
          {' "over the bar, and the span is pulled."'}
        </div>
        <div class="line"></div>

        <div class="line on" data-c="gray" style="--d:0.28s">
          <span class="map-row">
            <span class="map-row__name">dimension</span>
            <span class="map-row__bar">p</span>
            <span class="map-row__num">bar</span>
            <span class="map-row__route">route</span>
          </span>
        </div>

        {
          MAP_ROWS.map((r) => (
            <div class="line">
              <span class="map-row" style={`--d:${r.at}s`}>
                <span class="map-row__name" data-c={r.pulled ? 'red' : 'fg'}>
                  {r.title}
                </span>
                <span class="map-row__bar grow" data-c={r.pulled ? 'red' : 'fg'} style={`--d:${r.at}s;--n:4`}>
                  {r.glyph}
                </span>
                <span class="map-row__num" data-c="dim">
                  {r.barText}
                </span>
                <span class="map-row__route" data-c={r.pulled ? 'red' : 'cyan'}>
                  {r.route}
                </span>
              </span>
            </div>
          ))
        }

        <div class="line"></div>
        <div class="line on" data-c="magenta" style="--d:3.3s">
          {' 3 of 8 over bar · span pulled · reframed, then re-scored'}
        </div>
        <div class="line on" data-c="dim" style="--d:3.5s">
          {' whole-view pass after the spans: a task is refused for its shape, not its parts.'}
        </div>
        <div class="line on" data-c="dim" style="--d:3.65s">
          {' KIND_SLACK  fixture +0.10 · sig +0.05 · overall -0.05'}
        </div>
      </div>

      <!-- ============================================== 3 · outbound view -->
      <div class="shot shot--gate">
        <div class="line on" data-c="yellow" style="--d:0.05s">
          {' gate: the outbound view'}
        </div>
        <div class="line on" data-c="dim" style="--d:0.15s">
          {' 8 hard rules · denylist · framing hints (non-blocking)'}
        </div>
        <div class="line"></div>
        <div class="line on" style="--d:0.3s">
          <span class="run" data-c="teal">{'contracts/extract.py  '}</span>
          <span class="run" data-c="fg">{'def extract(payload: bytes) -> dict[str, float]'}</span>
        </div>
        <div class="line on" data-c="dim" style="--d:0.42s">
          {'    """Given a payload, return per-field scores in [0, 1]. Monotonic in each field."""'}
        </div>
        <div class="line"></div>
        <div class="line on" data-c="orange" style="--d:0.55s">
          {' "describe behaviour, not lineage. the private half is a black box."'}
        </div>
        <div class="line"></div>
        <div class="line on" data-c="gray" style="--d:0.7s">{' layers on the outbound view'}</div>
        <div class="line on" data-c="fg" style="--d:0.8s">
          <span class="run">{'  1 orchestrator partition  '}</span>
          <span class="run" data-c="dim">{'semantic'}</span>
        </div>
        <div class="line on" data-c="fg" style="--d:0.9s">
          <span class="run">{'  2 regex gate              '}</span>
          <span class="run" data-c="dim">{'deterministic'}</span>
        </div>
        <div class="line on" data-c="fg" style="--d:1.0s">
          <span class="run">{'  3 risk scorer             '}</span>
          <span class="run" data-c="dim">{'probabilistic'}</span>
        </div>
        <div class="line on" data-c="fg" style="--d:1.1s">
          <span class="run">{'  4 human review            '}</span>
          <span class="run" data-c="dim">{'unless --yes'}</span>
        </div>
        <div class="line"></div>
        <div class="line on" data-c="cyan" style="--d:1.3s">
          {' 0 blocks · decoy fixtures attached · nothing pointing at the private root'}
        </div>
      </div>

      <!-- ============================================== 4 · the split -->
      <div class="shot shot--split">
        <div class="line on" data-c="yellow" style="--d:0.05s">
          {' the split'}
        </div>
        <div class="line"></div>
        <div class="cols">
          <div class="col">
            <div class="line on" data-c="cyan" style="--d:0.2s">
              {' public/  ·  [CC] builds this'}
            </div>
            {
              PUBLIC_TREE.map((row, i) => (
                <div class="line on" data-c={i === 0 ? 'white' : 'fg'} style={`--d:${0.3 + i * 0.1}s`}>
                  {row}
                </div>
              ))
            }
          </div>
          <div class="col col--rule">
            <div class="line on" data-c="magenta" style="--d:0.5s">
              {' private_impl/  ·  orchestrator builds this'}
            </div>
            {
              PRIVATE_TREE.map((row, i) => (
                <div class="line on" data-c={i === 0 ? 'white' : 'fg'} style={`--d:${0.6 + i * 0.1}s`}>
                  {row}
                </div>
              ))
            }
          </div>
        </div>

        <div class="line"></div>
        <div class="line on" data-c="dim" style="--d:1.9s">
          {' joined by contract.json: brief · interfaces · decoy fixtures · private fixtures · notes'}
        </div>
        <div class="line"></div>
        <div class="line on" data-c="fg" style="--d:2.2s">
          <span class="run">{' HARNESS_MODE=stub  '}</span>
          <span class="run" data-c="dim">{'fixtures answer'}</span>
        </div>
        <div class="line on" data-c="fg" style="--d:2.35s">
          <span class="run">{' HARNESS_MODE=real  '}</span>
          <span class="run" data-c="dim">{'private_impl answers'}</span>
        </div>
        <div class="line on" data-c="cyan" style="--d:2.55s">
          {' tests/test_contracts.py ......... ok   # the fit is proven, not asserted'}
        </div>
      </div>

      <!-- ============================================== 5 · why -->
      <div class="shot shot--close">
        <div class="line on" data-c="orange" style="--d:0.05s">
          {' "the thing i actually wanted was to hand the boring 90% to the model that is good at boring,"'}
        </div>
        <div class="line on" data-c="orange" style="--d:0.2s">
          {' "and hand the part it flinches at to one that does not flinch."'}
        </div>
        <div class="line"></div>
        <div class="line on" data-c="dim" style="--d:0.35s">
          {' no jailbreak, no prompt poem, no arguing with anything.'}
        </div>
        <div class="line"></div>
        <div class="banner on" style="--d:0.5s;color:var(--fg)">
          <div class="line">{'  prompt -----> orchestrator -----> contract.json'}</div>
          <div class="line">{'                  (sees all)         |'}</div>
          <div class="line">{'                                     +--> public/       [CC] builds'}</div>
          <div class="line">{'                                     |    stubs, tests, decoy fixtures'}</div>
          <div class="line">{'                                     +--> private_impl/  refuseless builds'}</div>
        </div>
        <div class="line"></div>
        <div class="line on" data-c="fg" style="--d:0.9s">
          {' you know which half of your own project is the risky half. say so once,'}
        </div>
        <div class="line on" data-c="fg" style="--d:1.05s">
          {' and each model gets the half it is best suited to.'}
        </div>
      </div>

      <!-- ============================================== 6 · ship -->
      <div class="shot shot--end">
        <div class="banner on" style="--d:0.05s">
          {BANNER.map((row) => <div class="line">{row}</div>)}
        </div>
        <div class="line on" data-c="cyan" style="--d:0.45s">
          {'refusal-first split build'}
        </div>
        <div class="line"></div>
        <div class="line on" data-c="dim" style="--d:0.6s">{'install'}</div>
        <div class="line on" data-c="white" style="--d:0.7s">
          <span class="run">{'  uv tool install killchain'}</span>
        </div>
        <div class="line on" data-c="white" style="--d:0.82s">
          <span class="run">{'  killchain "your task"'}</span>
        </div>
        <div class="line"></div>
        <div class="line on" data-c="dim" style="--d:1.0s">
          {'python 3.11+ · no dependencies · MIT'}
        </div>
      </div>
    </div>

    <!-- statusline: mode, what you are watching, and the controls -->
    <div class="boot__status">
      <span class="boot__mode">NORMAL</span>
      <span data-c="dim">[RO]</span>
      <span data-c="fg">boot.ts</span>
      <span class="dim">·</span>
      <button class="boot__btn" type="button" data-boot-skip hidden>esc skip</button>
      <button class="boot__btn" type="button" data-boot-replay hidden>r replay</button>
      <span class="boot__status-right">bbt437 · murphy · <span data-shot-label>{last.label}</span></span>
    </div>

    <div class="boot__scan" aria-hidden="true"></div>
  </div>
</section>

<script>
  import { init } from '../lib/boot';
  const root = document.querySelector<HTMLElement>('.boot');
  if (root) init(root);
</script>
