---
import Base from '../layouts/Base.astro';
import Boot from '../components/Boot.astro';
import '../styles/page.css';

/** Every row here is a real switch in killchain/routing.py. */
const ROUTING = [
  ['DIMENSIONS', 'the refusal dimensions, and the question the scorer asks for each'],
  ['SAFE', 'what a frontier agent builds without comment'],
  ['HARD_RULES', 'regexes that block a send, no model involved'],
  ['FRAMING_HINTS', 'warnings for clone, hedge and licence wording'],
  ['THRESHOLDS', 'risk needed to pull a span, per dimension and span kind'],
  ['classify()', 'the per-span decision'],
  ['pick_frontier()', 'which coding agent builds the public half'],
  ['split_prompt()', 'how the prompt is cut into spans'],
];

const PREREQS = [
  ['claude or codex', 'one of the two CLIs on your PATH. It builds the public half. Set which in [frontier] backend.'],
  ['REFUSELESS_API_KEY', 'the abliterated orchestrator. It reads the full prompt and writes the private half.'],
  ['OPENROUTER_API_KEY', 'the risk scorer, Jev over the OpenRouter Decisions API. It decides which spans are refusal risk.'],
];

const LIMITS = [
  'The scorer guesses. Refusals are random and change with model versions. A model can still balk at something no dimension caught.',
  'Python interfaces only. The orchestrator returns JSON, no tool use. One contract round. No renegotiating mid-build.',
  "The frontier runs with permissions skipped. The private root is off its cwd and PYTHONPATH and its env is scrubbed. That's a convention. Nothing enforces it.",
];

const LINKS = [
  { href: 'https://github.com/jcpsimmons/killchain', label: 'github' },
  { href: 'https://pypi.org/project/killchain/', label: 'pypi' },
  { href: 'https://youtube.com/@drjoshcsimmons', label: 'youtube' },
];
---

<Base>
  <div class="page">
    <header class="topbar">
      <span class="topbar__mark"><b>killchain</b></span>
      <span class="topbar__ver">v0.1.3</span>
      <nav class="topbar__nav" aria-label="elsewhere">
        {LINKS.map((l) => <a href={l.href} rel="noopener">{l.label}</a>)}
      </nav>
    </header>

    <main id="main">
      <section class="intro wrap">
        <h1 class="intro__h">It can't refuse what it never read.</h1>
        <p class="intro__p">
          killchain is a Python 3.11+, zero-dependency, MIT, two-model, contract-joined build
          harness. An abliterated orchestrator reads the whole prompt. It hands Claude Code or
          Codex the public half, with stubs and decoy fixtures where the private functions go. It
          writes the private functions itself. Same tests, both halves.
        </p>
        <div class="cmd" data-copyable>
          <pre><code><span class="p">$ </span>uv tool install killchain</code></pre>
          <button class="copy" type="button" data-copy hidden>copy</button>
        </div>
      </section>

      <div class="film">
        <Boot />
      </div>

      <div class="wrap">
        <section class="block">
          <div class="slug">
            <span class="slug__n">01</span>
            <h2 class="slug__t">## run</h2>
            <span class="slug__rule"></span>
          </div>
          <div class="cmd cmd--block" data-copyable>
            <pre><code><span class="p">$ </span>killchain --doctor<span class="c">          # keys, denylist, round-trip</span>
<span class="p">$ </span>killchain "build X using our proprietary Y"
<span class="p">$ </span>killchain -f prompt.md --frontier codex --yes</code></pre>
            <button class="copy" type="button" data-copy hidden>copy</button>
          </div>
          <p class="aside">pipx and pip work too. <code>uvx killchain "your task"</code> runs it without installing.</p>
        </section>

        <section class="block">
          <div class="slug">
            <span class="slug__n">02</span>
            <h2 class="slug__t">## prereqs</h2>
            <span class="slug__rule"></span>
          </div>
          <p class="prose">
            No Python dependencies, but it is a front end for two models and one coding agent.
            A run needs all three.
          </p>
          <div class="table" role="table" aria-label="what a run needs">
            <div class="tr tr--head" role="row">
              <span role="columnheader">you need</span>
              <span role="columnheader">why</span>
            </div>
            {
              PREREQS.map(([k, v]) => (
                <div class="tr" role="row">
                  <span class="tr__k" role="cell">{k}</span>
                  <span class="tr__v" role="cell">{v}</span>
                </div>
              ))
            }
          </div>
          <p class="aside"><code>killchain --doctor</code> names whichever is missing and how to fix it.</p>
        </section>

        <section class="block">
          <div class="slug">
            <span class="slug__n">03</span>
            <h2 class="slug__t">## routing.py</h2>
            <span class="slug__rule"></span>
          </div>
          <p class="prose">
            One file says what the frontier sees. Edit it. The denylist is literals and regexes
            on top, no code.
          </p>
          <div class="table" role="table" aria-label="routing.py switches">
            <div class="tr tr--head" role="row">
              <span role="columnheader">in routing.py</span>
              <span role="columnheader">what it controls</span>
            </div>
            {
              ROUTING.map(([k, v]) => (
                <div class="tr" role="row">
                  <span class="tr__k" role="cell">{k}</span>
                  <span class="tr__v" role="cell">{v}</span>
                </div>
              ))
            }
          </div>
        </section>

        <section class="block">
          <div class="slug">
            <span class="slug__n">04</span>
            <h2 class="slug__t">## limits</h2>
            <span class="slug__rule"></span>
          </div>
          <ul class="limits">
            {LIMITS.map((l) => <li>{l}</li>)}
          </ul>
        </section>
      </div>
    </main>

    <footer class="foot">
      <div class="wrap foot__row">
        <span class="foot__mode">NORMAL</span>
        {LINKS.map((l) => <a href={l.href} rel="noopener">{l.label}</a>)}
        <a href="https://github.com/jcpsimmons/killchain/issues" rel="noopener">issues</a>
        <span class="foot__right">MIT · v0.1.0</span>
      </div>
    </footer>
  </div>
</Base>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const pre = btn.closest('[data-copyable]')?.querySelector<HTMLPreElement>('pre');
    if (!pre) continue;
    btn.hidden = false;
    btn.addEventListener('click', async () => {
      const text = pre.innerText
        .split('\n')
        .map((l) => l.replace(/^\$ /, '').replace(/\s+#.*$/, ''))
        .join('\n')
        .trim();
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = 'copied';
        window.setTimeout(() => (btn.textContent = 'copy'), 1600);
      } catch {
        btn.textContent = 'ctrl-c';
      }
    });
  }
</script>
